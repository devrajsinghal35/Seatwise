# Copy to server/.env and adjust. Every value below has a working default,
# so the app runs with no .env file at all.

PORT=4000

# Sign your own value before deploying anywhere public.
JWT_SECRET=change-this-to-a-long-random-string
TOKEN_TTL=12h

# SQLite file. The directory is created on first run.
DATABASE_FILE=./data/seatwise.db

# How long a checkout hold survives before the seat is released (seconds).
HOLD_TTL_SECONDS=600
# How long a waitlisted customer has to claim a seat freed for them (seconds).
OFFER_TTL_SECONDS=300
# How often the expiry sweep runs (seconds).
SWEEP_INTERVAL_SECONDS=5

# Used to build the claim link inside waitlist offer emails.
PUBLIC_URL=http://localhost:5173

# For transactional email via Brevo REST API.
# Leave BREVO_API_KEY blank to write .eml files to server/outbox instead of sending.
MAIL_FROM=SeatWise <devrajsinghal61@gmail.com>
BREVO_API_KEY=
# Where .eml files land when Brevo is not configured.
MAIL_OUTBOX=./outbox
